|{ cwd, include, ... }|
let
    lib = include "${cwd}/lead-lib/lead-lib.pbb" { };

    # The AES library selects its implementation by itself
    aes = include "${cwd}/lib/aes/aes.pbb" lib;

    my_app = lib.merge [
        lib.lang.c.mod {
            src = [
                "${cwd}/src/main.c",
            ];
        },
        aes,
    ];

    riscv_flags = [ "--target=riscv64-unknown-elf", "-march=rv64gc", "-mabi=lp64d" ];

    # Everything that is specific to a board: the compiler, its flags, and the
    # board support package
    board = {
        posix = lib.merge [
            lib.lang.c.config {
                # default flags for posix
                cmd_cc = "clang";
                cmd_ld = "clang";
            },
            lib.lang.c.mod {
                inc = [ "${cwd}/bsp/" ];
                src = [ "${cwd}/bsp/bsp_mock.c" ];
            },
        ];
        riscv64 = lib.merge [
            lib.lang.config.mod { arch = "riscv64"; },
            lib.lang.c.config {
                # Custom compiler and flags for target
                cmd_cc = "clang";
                cmd_ld = "clang";
                cflags = riscv_flags;
                # Bare metal: no C library or start files from the toolchain
                ldflags = riscv_flags ++ [ "-nostdlib" ];
            },
            lib.lang.c.mod {
                inc = [ "${cwd}/bsp/" ];
                src = [ "${cwd}/bsp/bsp_riscv64.c" ];
            },
        ];
    };
in
{
    # Native build, for running on the host
    native = lib.build [
        lib.lang.config.simple "${cwd}",
        lib.lang.c.app_build "my_app_native",
        board.posix,
        my_app,
    ];

    # Cross compiled build, for the platform
    platform = lib.build [
        lib.lang.config.simple "${cwd}",
        lib.lang.c.app_build "my_app_platform",
        board.riscv64,
        my_app,
    ];
}
