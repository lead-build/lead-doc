|{ cwd, include, ... }|
let
    lib = include "${cwd}/lead-lib/lead-lib.pbb" { };

    # The code under test, with its tests
    utils = lib.lang.c.mod {
        src = [ "${cwd}/src/utils.c" ];
        inc = [ "${cwd}/src/" ];
        tests = [
            "${cwd}/tests/test_add.c",
            "${cwd}/tests/test_mul.c",
        ];
    };

    # main() is kept out of the tests, since each test has its own
    app = lib.lang.c.mod {
        src = [ "${cwd}/src/main.c" ];
    };
in
{
    app = lib.build [
        lib.lang.config.simple "${cwd}",
        lib.lang.c.app_build "my_app",
        utils,
        app,
    ];

    test = lib.test_report "${cwd}/out/test_report.txt" [
        lib.lang.config.simple "${cwd}",
        utils,
    ];
}
